{
  "name": "secrets-store-container-demo",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  
  // Secrets Store configuration
  "secrets_store": [
    {
      "binding": "API_SECRETS",
      "store_id": "my-app-secrets"
    }
  ],

  // Durable Object configuration for Container class
  "durable_objects": {
    "bindings": [
      {
        "name": "SECRETS_STORE_CONTAINER",
        "class_name": "SecretsStoreContainer"
      }
    ]
  },

  // Migration configuration
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecretsStoreContainer"]
    }
  ],

  // Environment variables (automatically generated by Container class)
  "vars": {
    "ENVIRONMENT": "development"
  }
}
